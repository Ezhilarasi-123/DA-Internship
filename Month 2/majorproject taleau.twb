      <column caption='Total Postings' datatype='integer' name='[Calculation_1029996577550336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([title])' />
      </column>
      <column caption='Fraudulent Postings' datatype='integer' name='[Calculation_1029996578160641]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fraudulent])' />
      </column>
      <column caption='Fraud Rate' datatype='real' default-format='p0.0%' name='[Calculation_1029996579082242]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fraudulent]) / COUNT([title])' />
      </column>
      <column caption='Genuine Postings' datatype='integer' name='[Calculation_1029996579663875]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([title]) - SUM([fraudulent])' />
      </column>
      <column caption='Fraud Count by Industry' datatype='integer' name='[Calculation_1029996581224452]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [industry] : SUM([fraudulent]) }' />
      </column>
      <column caption='Fraud flag' datatype='string' name='[Calculation_1418674040573952]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [fraudulent] = 1 THEN &quot;Fraudulent&quot; ELSE &quot;Genuine&quot; END' />
      </column>
      <column caption='Fake %' datatype='real' name='[Calculation_1639126309666816]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fraudulent])/COUNT([title])' />
      </column>
      <column caption='Real Jobs' datatype='integer' name='[Calculation_1639126313844737]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([title])-SUM([fraudulent])' />
